MOUSEKEY_ENABLE = yes       # Mouse keys with acceleration
EXTRAKEY_ENABLE = yes       # Audio control and System control
CONSOLE_ENABLE = no         # Console for debug
COMMAND_ENABLE = no         # Commands for debug and configuration
NKRO_ENABLE = yes          # Enable N-Key Rollover
BACKLIGHT_ENABLE = no      # Enable keyboard backlight functionality
RGBLIGHT_ENABLE = no       # Enable keyboard RGB underglow (disabled for per-key)
RGB_MATRIX_ENABLE = yes    # Enable RGB Matrix for per-key lighting
AUDIO_ENABLE = no          # Audio output

# Force NKRO to be enabled by default
FORCE_NKRO = yes

# Enable Link Time Optimization to reduce firmware size
LTO_ENABLE = yes

# Custom matrix for per-key RGB control
RGB_MATRIX_DRIVER = ws2812

